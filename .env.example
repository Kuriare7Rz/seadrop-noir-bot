# =============================================================================
# SEADROP MINT BOT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# -----------------------------------------------------------------------------
# RPC
# -----------------------------------------------------------------------------
ALCHEMY_API_KEY=
BACKUP_RPC_URL=https://cloudflare-eth.com

# -----------------------------------------------------------------------------
# OpenSea API v2
# Required. Free keys: POST https://api.opensea.io/api/v2/auth/keys (max 2/day,
# expire in 7 days). Can also be hot-swapped at runtime via the /api command
# (DB override survives restarts and takes precedence over this value).
# -----------------------------------------------------------------------------
OPENSEA_API_KEY=

# -----------------------------------------------------------------------------
# Etherscan
# -----------------------------------------------------------------------------
ETHERSCAN_API_KEY=

# -----------------------------------------------------------------------------
# Wallets (up to 100 EOA burner wallets)
# WARNING: These are plaintext private keys. Protect this file.
# Use burner wallets only. Never use wallets with significant funds.
# -----------------------------------------------------------------------------
WALLET_1_KEY=
WALLET_2_KEY=
WALLET_3_KEY=
# WALLET_4_KEY=
# WALLET_5_KEY=
# ... up to WALLET_100_KEY=

# -----------------------------------------------------------------------------
# Mint Defaults (overridable per user via /set_* commands)
# OPTIMIZED VALUES: These settings provide minimal gas costs (~0.00002-0.00003 ETH)
# -----------------------------------------------------------------------------
DEFAULT_MAX_MINT_PRICE_ETH=0.1
DEFAULT_MAX_GAS_ETH=0.005          # Optimized: reduced from 0.02
DEFAULT_QUANTITY=1
LOW_BALANCE_THRESHOLD_ETH=0.0001   # Optimized: reduced from 0.05
MAX_PRIORITY_FEE_GWEI=0.01         # Optimized: reduced from 0.1 (supports decimals)
TX_TIMEOUT_SECONDS=120             # Optimized: reduced from 300 (fail-fast)
QUEUE_CONCURRENCY=10

# Multi-wallet mint settings
MULTI_WALLET_CONCURRENCY=5         # How many wallets mint in parallel (1-100 range)
MULTI_WALLET_PROGRESS_INTERVAL=10  # Progress log interval in seconds

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# GoPlus Security
# Set to true to block mints when GoPlus API is unavailable
# -----------------------------------------------------------------------------
GOPLUS_STRICT_MODE=false

# -----------------------------------------------------------------------------
# Dry Run Mode
# Set to true to force ALL /mint commands to run as simulations.
# No transactions are ever sent while this is enabled.
# -----------------------------------------------------------------------------
DRY_RUN_MODE=false

# -----------------------------------------------------------------------------
# Redis (optional — enables BullMQ persistent queue)
# If not set, p-queue in-memory queue is used
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ── Multi-chain (added) ─────────────────────────────────────────────
# Which chain to mint on: ethereum (default) or robinhood
MINT_CHAIN=ethereum
# Robinhood Chain RPC (used only when MINT_CHAIN=robinhood). Public default works.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# -----------------------------------------------------------------------------
# Low-balance alerts
# Balance is always checked + logged. This only controls Telegram push spam.
# With many empty fleet wallets, keep false (else every cycle pings the chat).
# -----------------------------------------------------------------------------
LOW_BALANCE_ALERTS=false

# -----------------------------------------------------------------------------
# Window Guard (stage-aware) — when a drop stage has not opened yet, poll until
# ANY eligible stage (WL/presale/public) opens, then fire. Never forces public.
# -----------------------------------------------------------------------------
WINDOW_GUARD_ENABLED=true
WINDOW_GUARD_MAX_WAIT_SECONDS=900   # max wait for the window before giving up
WINDOW_GUARD_POLL_MS=3000           # poll interval while waiting
SCHEDULE_AUTO_ALIGN=true            # align /schedule time to stage start if early

# -----------------------------------------------------------------------------
# Snipe Mode (default ON for scheduled mints)
# Pre-arms wallet/gas before open, hammers OpenSea /mint until 200, then blasts.
# The chain-aware knobs are BLANK by default -> use the active chain profile
# (see src/chains.ts). Set a value only to force-override for all chains.
# -----------------------------------------------------------------------------
SNIPE_ENABLED=true
SNIPE_RPC_PRECHECK=true             # benchmark + re-rank RPCs during pre-arm
SNIPE_PARALLEL_BROADCAST=true       # blast signed tx to ALL ranked RPCs (first wins)
SNIPE_MAX_HAMMER_SECONDS=60         # max hammer duration before giving up
SNIPE_LEAD_MS=                      # start hammering N ms before open (blank=profile)
SNIPE_HAMMER_INTERVAL_MS=           # ms between /mint attempts (blank=profile)
SNIPE_PRIORITY_FEE_GWEI=            # priority fee on snipe path (blank=profile)
SNIPE_GAS_LIMIT=                    # fixed gas limit to skip estimateGas (blank=profile)
SNIPE_BASEFEE_MULTIPLIER=           # maxFee = baseFee*mult + tip (blank=profile)

# -----------------------------------------------------------------------------
# Proxy rotation for OpenSea API (bypass per-IP 429 rate limits)
# Master switch. Even when true, rotation only activates if the DB-backed proxy
# pool (managed via /add_proxy) has >=1 enabled proxy. Empty pool = direct.
# -----------------------------------------------------------------------------
PROXY_ENABLED=true
PROXY_CHECK_TIMEOUT_MS=8000         # timeout for /check_proxy health checks

# -----------------------------------------------------------------------------
# 429 backoff + jitter (softens rate limits even without proxies)
# -----------------------------------------------------------------------------
RATE_LIMIT_BACKOFF_MS=1000          # wait on 429 (or Retry-After if provided)
HAMMER_JITTER_MS=120                # random 0..N ms per attempt to spread bursts
